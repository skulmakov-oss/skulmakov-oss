fn main() {
    let mut m: Map(i32, i32) = map_empty();
    let mut i: i32 = 0;
    while i < 16000 { m = map_set(m, i, i); i = i + 1; }
    let old: Map(i32, i32) = m;
    let mut j: i32 = 0;
    while j < 16000 { m = map_set(m, j, -1); j = j + 1; }
    assert(map_get(old, 8000, 0) == 8000);
    assert(map_get(m, 8000, 0) == -1);
    return;
}
