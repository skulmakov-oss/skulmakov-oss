record State10 {
toks: Sequence(i32),
a1: i32, a2: i32, a3: i32, a4: i32,
a5: i32, a6: i32, a7: i32, a8: i32,
pos: i32
}
fn main() {
let mut st: State10 = State10 {
toks: [], a1: 1, a2: 2, a3: 3, a4: 4,
a5: 5, a6: 6, a7: 7, a8: 8, pos: 0
};
let mut i: i32 = 0;
while i < 16000 {
st = st with { toks: push(st.toks, i), pos: st.pos + 1 };
i = i + 1;
}
assert(len(st.toks) == 16000);
return;
}
